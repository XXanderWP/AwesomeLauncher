{
  "name": "awesomecraft-launcher",
  "version": "1.4.5",
  "productName": "AwesomeCraftLauncher",
  "description": "Minecraft launcher for AwesomeCraft projects",
  "author": "AwesomeCraft",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/XXanderWP/AwesomeLauncher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XXanderWP/AwesomeLauncher.git"
  },
  "bugs": {
    "url": "https://github.com/XXanderWP/AwesomeLauncher/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-launch-assets.cjs && electron-vite dev",
    "build": "electron-vite build && node scripts/copy-launch-assets.cjs",
    "preview": "node scripts/copy-launch-assets.cjs && electron-vite preview",
    "start": "node scripts/copy-launch-assets.cjs && electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "locator:build": "node scripts/build-neoforge-locators.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "node scripts/patch-helios-core.cjs && electron-builder install-app-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "@xxanderwp/translate-module": "^1.0.7",
    "adm-zip": "^0.5.16",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "got": "^11.8.6",
    "helios-core": "~2.3.0",
    "helios-distribution-types": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.7.3",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.2",
    "@types/discord-rpc": "^4.0.11",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  }
}
